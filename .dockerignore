# Allow-list: nothing enters the build context unless it is named below. This keeps the template workbook,
# handoff/, tests/, .claude/, .agents/, docs, env files and local databases out of every image layer.
*
!package.json
!package-lock.json
!.npmrc
!tsconfig*.json
!vite.config.ts
!src/

# Explicit denials, as a second line of defence if the allow-list is ever widened.
**/.env
**/.env.*
**/*.xlsx
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite*
**/node_modules
**/dist
reference
handoff
tests
docs
.claude
.agents
.git
