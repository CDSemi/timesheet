{
  "name": "timesheet",
  "version": "0.1.0",
  "private": true,
  "description": "Personal timesheet and internal OT tracker (WP1 foundation).",
  "type": "module",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke",
    "digest": "node scripts/source-digest.mjs",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "test": "vitest run",
    "test:fixtures": "vitest run tests/domain",
    "smoke": "node scripts/smoke-built-server.mjs",
    "migrate": "node dist/server/cli.js migrate",
    "seed": "node dist/server/cli.js seed",
    "start": "node dist/server/index.js",
    "dev:server": "node --watch src/server/index.ts",
    "dev:client": "vite"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "better-sqlite3": false
  }
}
