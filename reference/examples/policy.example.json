{
  "schema_version": 1,
  "example_only": true,
  "identity": {
    "display_name": "Example Employee",
    "employee_email": "employee@example.invalid"
  },
  "calendar": {
    "reporting_zone": "America/Los_Angeles",
    "normal_weekdays_iso": [
      1,
      2,
      3,
      4,
      5
    ],
    "holiday_calendar_id": "company-2026"
  },
  "policy": {
    "effective_from": "2026-01-01",
    "required_minutes": 480,
    "reference_start": "08:00",
    "reference_end": "17:00",
    "break_placement": "elapsed_from_first_clock_in",
    "breaks": [
      {
        "start_offset_minutes": 120,
        "duration_minutes": 15,
        "counts_as_work": false
      },
      {
        "start_offset_minutes": 240,
        "duration_minutes": 30,
        "counts_as_work": false
      },
      {
        "start_offset_minutes": 390,
        "duration_minutes": 15,
        "counts_as_work": false
      }
    ],
    "threshold_minutes": 30,
    "threshold_comparison": "strictly_greater",
    "threshold_mode": "activation_not_deduction",
    "rounding_step_minutes": 30,
    "rounding_mode": "nearest_midpoint_down",
    "nonworking_threshold_minutes": 0,
    "nonworking_required_minutes": 0,
    "deficit_mode": "ignore",
    "ot_leave_conversion_ratio": 1
  },
  "payroll": {
    "anchor_payroll_date": "2026-10-02",
    "cycle_days": 14,
    "period_start_offset_days": -18,
    "period_end_offset_days": -5,
    "due_offset_days": -3,
    "due_local_time": "17:00"
  },
  "display": {
    "time_zone": "device",
    "time_format": "24h"
  },
  "submission": {
    "auto_submit_unsigned": true,
    "auto_signature_image": false,
    "auto_note_enabled": false,
    "auto_note_text": "Automatic submission",
    "show_ot_on_pdf": true,
    "reminder_offsets_minutes": [
      1440,
      120
    ],
    "recipients_to": [
      "manager@example.invalid"
    ],
    "recipients_cc": [],
    "email_subject": "Timesheet — {EmployeeName} — {PayrollDate} — r{Revision}",
    "email_body": "Hello,\n\nPlease find my timesheet for {PeriodStart} through {PeriodEnd} attached.\nStatus: {SignOffStatus}.\nSubmission: {SubmissionId}, revision {Revision}.\n\nThank you,\n{EmployeeName}",
    "notification_channel": "email"
  },
  "operations": {
    "outbound_mode": "dry_run",
    "automation_active_from": null,
    "production_sending_enabled": false
  }
}
