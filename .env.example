# Timesheet configuration example. Every value below is a synthetic placeholder.
# Copy to a protected host file (for example /volume1/docker/timesheet/.env, mode 600) that is
# never committed, never pasted into chat and never shown in screenshots or logs.
#
# The application needs NO session secret and NO token-signing secret: a session is a random
# 256-bit token that the database stores only as a hash, so there is nothing to configure or
# rotate for it. The only secret the application can hold is the SMTP password, and that is
# read only when OUTBOUND_MODE=smtp.

# --- Runtime -------------------------------------------------------------------------------
# development (default) or production. Production refuses to start unless DATABASE_PATH,
# DATA_DIR, APP_ORIGINS and PUBLIC_BASE_URL are set explicitly (see below).
NODE_ENV=production

# Bind address. The default is 127.0.0.1 (this machine only). Inside a container set 0.0.0.0 so
# the published port reaches the process, and publish the port only to the reverse proxy or the
# trusted network, never to the internet.
HOST=0.0.0.0
PORT=3000

# --- Storage (production: both are required and must be absolute paths) -----------------
# One host-local volume mounted at /data. Never a Dropbox folder, a remote SMB/NFS share or
# the static web root.
DATABASE_PATH=/data/timesheet.db
DATA_DIR=/data/private-data

# --- Public address and browser protection -------------------------------------------------
# Exact browser origin(s) allowed to send state-changing requests, comma separated, no path.
APP_ORIGINS=https://timesheet.example.invalid
# Public URL used in login-required deep links. https only in production; no credentials,
# query or fragment.
PUBLIC_BASE_URL=https://timesheet.example.invalid
# Defaults to true in production and false otherwise; set it only to override.
# COOKIE_SECURE=true
# Session lifetime in hours (default 168).
# SESSION_TTL_HOURS=168

# --- Reverse proxy -------------------------------------------------------------------------
# Exact IP addresses (no CIDR, no host names) of the reverse proxies whose X-Forwarded-For is
# believed for the sign-in rate limit. Empty or unset (the default) trusts no proxy and ignores
# every forwarded header. The proxy must append the real client address to X-Forwarded-For.
# Use the address the app sees as the connection peer (for example the Docker bridge gateway).
TRUSTED_PROXY_ADDRESSES=

# --- Outbound mail -------------------------------------------------------------------------
# capture (default) writes messages to DATA_DIR and never touches the network.
OUTBOUND_MODE=capture
# Sender address for captured and real messages.
MAIL_FROM=timesheet@example.invalid
# The settings below are read only when OUTBOUND_MODE=smtp. Real sending also needs the
# owner-only flag set to exactly "true"; leave it unset until the owner authorizes the pilot.
# PRODUCTION_SENDING_ENABLED=
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=

# --- Optional ------------------------------------------------------------------------------
# JOB_RUNNER=off disables the in-process job runner (tests and drills only; leave unset).
# JOB_RUNNER=
# Directory of the built client when it is not next to the compiled server.
# STATIC_DIR=
# Passwords for `npm run seed` (development only; the seed is refused in production).
# SEED_ADMIN_PASSWORD=
# SEED_EMPLOYEE_PASSWORD=
# SEED_EMPLOYEE2_PASSWORD=
